---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	showToc?: boolean;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], showToc = true } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.content-area {
				width: min(1200px, calc(100% - 2em));
				max-width: 1200px;
				margin: auto;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.article-layout {
				display: block;
			}
			.article-body {
				min-width: 0;
			}
			.article-body :global(h1[id]) {
				font-size: 2.5em;
			}
			.article-body :global(h2) {
				font-size: 1.55em;
			}
			.article-body :global(h3) {
				font-size: 1.2em;
			}
			:global(.article-body h1)::before,
			:global(.article-body h2)::before,
			:global(.article-body h3)::before,
			:global(.article-body h4)::before,
			:global(.article-body h5)::before,
			:global(.article-body h6)::before {
				margin-right: 0.25em;
				color: rgb(179, 147, 236);
				font-weight: 400;
			}
			:global(.article-body h1)::before { content: '#'; }
			:global(.article-body h2)::before { content: '##'; }
			:global(.article-body h3)::before { content: '###'; }
			:global(.article-body h4)::before { content: '####'; }
			:global(.article-body h5)::before { content: '#####'; }
			:global(.article-body h6)::before { content: '######'; }
			.article-body :global(li > ul),
			.article-body :global(li > ol) {
				margin-top: 0.2rem;
				margin-bottom: 0.2rem;
			}
			.toc {
				position: static;
				width: 100%;
				margin: 0 0 2rem;
				padding: 1rem;
				border-left: 1px solid rgb(var(--gray-light));
			}
			.toc h2 {
				margin-bottom: 0.65rem;
				font-size: 1rem;
			}
			.toc nav {
				display: grid;
				gap: 0.35rem;
			}
			:global(.toc a) {
				position: relative;
				color: rgb(var(--gray));
				font-size: 0.82rem;
				line-height: 1.4;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			:global(.toc a::before) {
				position: absolute;
				left: -1.05rem;
				top: 0;
				width: 2px;
				height: 100%;
				border-radius: 999px;
				background: var(--accent);
				content: '';
				transform: scaleY(0);
				transition: transform 0.2s ease;
			}
			:global(.toc a:hover),
			:global(.toc a.is-active) {
				color: rgb(var(--accent));
			}
			:global(.toc a:hover::before),
			:global(.toc a.is-active::before) {
				transform: scaleY(1);
			}
			:global(.toc a.toc-subitem) {
				padding-left: 0.75rem;
				font-size: 0.75rem;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2.5em;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-bottom: 1rem;
			}
			.tags span {
				padding: 0.15rem 0.55rem;
				border-radius: 999px;
				background: rgba(122, 69, 246, 0.1);
				color: rgb(122, 69, 246);
				font-size: 0.75rem;
			}
			@media (max-width: 900px) {
				.content-area {
					display: block;
					width: 100%;
				}
				.prose {
					max-width: calc(100% - 2em);
					margin: auto;
				}
				.toc {
					position: static;
					max-width: 720px;
					margin: 0 auto 1rem;
					border: 1px solid rgb(var(--gray-light));
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="content-area">
					<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{tags.length > 0 && (
							<div class="tags" aria-label="Tags">
								{tags.map((tag) => <span>#{tag}</span>)}
							</div>
						)}
						<hr />
					</div>
					<div class="article-layout">
						{showToc && (
							<aside class="toc" hidden>
								<h2>On this Page</h2>
								<nav aria-label="目次" id="table-of-contents"></nav>
							</aside>
						)}
						<div class="article-body">
							<slot />
						</div>
					</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const toc = document.querySelector('.toc');
			const tocNav = document.querySelector('#table-of-contents');
			const headings = document.querySelectorAll('.prose h2, .prose h3');

			if (toc && tocNav && headings.length > 0) {
				const usedIds = new Set();
				headings.forEach((heading, index) => {
					const baseId = heading.textContent?.trim().toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-') || `heading-${index}`;
					let id = baseId;
					let suffix = 1;
					while (usedIds.has(id)) id = `${baseId}-${suffix++}`;
					usedIds.add(id);
					heading.id = id;

					const link = document.createElement('a');
					link.href = `#${id}`;
					link.textContent = heading.textContent || '';
						if (heading.tagName === 'H3') link.className = 'toc-subitem';
						tocNav.appendChild(link);
				});
				const links = [...tocNav.querySelectorAll('a')];
				let preserveClickedLink = false;
				const updateActiveLink = () => {
					if (preserveClickedLink) return;
					let activeIndex = 0;
					let closestDistance = Number.POSITIVE_INFINITY;
					headings.forEach((heading, index) => {
						const distance = Math.abs(heading.getBoundingClientRect().top - 120);
						if (distance < closestDistance) {
							closestDistance = distance;
							activeIndex = index;
						}
					});
					links.forEach((link, index) => link.classList.toggle('is-active', index === activeIndex));
				};
				links.forEach((link, index) => {
					link.addEventListener('click', () => {
						preserveClickedLink = true;
						links.forEach((item, linkIndex) => item.classList.toggle('is-active', linkIndex === index));
						window.setTimeout(() => {
							preserveClickedLink = false;
						}, 700);
					});
				});
				window.addEventListener('scroll', updateActiveLink, { passive: true });
				updateActiveLink();
				toc.hidden = false;
			}
		</script>
	</body>
</html>
