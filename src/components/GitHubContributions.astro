---
const username = import.meta.env.GITHUB_USERNAME || 'nax2orbit';
const token = import.meta.env.GH_CONTRIBUTIONS_TOKEN;

type ContributionDay = {
	contributionCount: number;
	date: string;
};

type ContributionCalendar = {
	totalContributions: number;
	weeks: { contributionDays: ContributionDay[] }[];
};

let calendar: ContributionCalendar | undefined;

if (token) {
	const to = new Date();
	const from = new Date(to);
	from.setFullYear(from.getFullYear() - 1);

	try {
		const response = await fetch('https://api.github.com/graphql', {
			method: 'POST',
			headers: {
				Authorization: `Bearer ${token}`,
				'Content-Type': 'application/json',
			},
			body: JSON.stringify({
				query: `
					query Contributions($login: String!, $from: DateTime!, $to: DateTime!) {
						user(login: $login) {
							contributionsCollection(from: $from, to: $to) {
								contributionCalendar {
									totalContributions
									weeks { contributionDays { contributionCount date } }
								}
							}
						}
					}
				`,
				variables: { login: username, from: from.toISOString(), to: to.toISOString() },
			}),
		});
		const result = await response.json();
		calendar = result.data?.user?.contributionsCollection?.contributionCalendar;
	} catch {
		calendar = undefined;
	}
}

let previousMonth = -1;
const monthLabels = calendar?.weeks.map((week) => {
	const month = new Date(week.contributionDays[0]?.date).getMonth();
	const label = month !== previousMonth ? new Date(week.contributionDays[0]?.date).toLocaleDateString('en-US', { month: 'short' }) : '';
	previousMonth = month;
	return label;
}) || [];

const contributionLevel = (count: number) => {
	if (count === 0) return 0;
	if (count <= 2) return 1;
	if (count <= 5) return 2;
	if (count <= 9) return 3;
	return 4;
};
---

{
	calendar && (
		<section class="contributions" aria-labelledby="contributions-title">
			<div class="contributions-heading">
				<h2 id="contributions-title">GitHub Contributions</h2>
				<a href={`https://github.com/${username}`} target="_blank" rel="noreferrer">
					{calendar.totalContributions} contributions in the last year
				</a>
			</div>
			<div class="calendar-layout">
				<div class="weekdays" aria-hidden="true">
					<span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
				</div>
				<div class="calendar-scroll">
					<div class="months" aria-hidden="true">
						{monthLabels.map((label) => <span>{label}</span>)}
					</div>
					<div class="days" aria-label={`GitHub contribution calendar for ${username}`}>
						{calendar.weeks.flatMap((week) =>
							week.contributionDays.map((day) => (
								<span
									class={`day level-${contributionLevel(day.contributionCount)}`}
									title={`${day.date}: ${day.contributionCount} contributions`}
								></span>
							)),
						)}
					</div>
				</div>
			</div>
		</section>
	)
}

<script>
	const calendar = document.querySelector<HTMLElement>('.calendar-scroll');
	if (calendar) {
		requestAnimationFrame(() => {
			calendar.scrollLeft = calendar.scrollWidth;
		});
	}
</script>

<style>
	.contributions {
		margin-top: 3rem;
	}
	.contributions-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.contributions-heading h2 {
		margin: 0;
		font-size: 1.2rem;
	}
	.contributions-heading a {
		font-size: 0.75rem;
		text-decoration: none;
	}
	.calendar-layout {
		display: flex;
		align-items: end;
		gap: 0.45rem;
	}
	.calendar-scroll {
		overflow-x: auto;
		padding-bottom: 0.4rem;
	}
	.months,
	.days {
		width: max-content;
		min-width: 860px;
	}
	.months {
		display: grid;
		grid-template-columns: repeat(53, 12px);
		gap: 4px;
		margin-bottom: 0.35rem;
		color: rgb(var(--gray));
		font-size: 0.65rem;
		line-height: 1;
	}
	.months span {
		width: 32px;
		white-space: nowrap;
	}
	.weekdays {
		display: grid;
		grid-template-rows: repeat(7, 12px);
		gap: 4px;
		width: 26px;
		color: rgb(var(--gray));
		font-size: 0.55rem;
		line-height: 12px;
		margin-bottom: 0.4rem;
	}
	.days {
		display: grid;
		grid-template-rows: repeat(7, 12px);
		grid-auto-flow: column;
		grid-auto-columns: 12px;
		gap: 4px;
	}
	.day {
		width: 12px;
		height: 12px;
		border-radius: 3px;
	}
	.level-0 { background: rgba(96, 115, 159, 0.15); }
	.level-1 { background: rgba(179, 147, 236, 0.35); }
	.level-2 { background: rgb(179, 147, 236); }
	.level-3 { background: rgb(122, 69, 246); }
	.level-4 { background: rgb(91, 33, 182); }
	@media (max-width: 720px) {
		.contributions-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.2rem;
		}
	}
</style>
