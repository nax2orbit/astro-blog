---
const username = import.meta.env.GITHUB_USERNAME || 'nax2orbit';
const token = import.meta.env.GH_CONTRIBUTIONS_TOKEN;

type ContributionDay = {
	contributionCount: number;
	date: string;
	color: string;
};

type ContributionCalendar = {
	totalContributions: number;
	weeks: { contributionDays: ContributionDay[] }[];
};

let calendar: ContributionCalendar | undefined;

if (token) {
	const to = new Date();
	const from = new Date(to);
	from.setFullYear(from.getFullYear() - 1);

	try {
		const response = await fetch('https://api.github.com/graphql', {
			method: 'POST',
			headers: {
				Authorization: `Bearer ${token}`,
				'Content-Type': 'application/json',
			},
			body: JSON.stringify({
				query: `
					query Contributions($login: String!, $from: DateTime!, $to: DateTime!) {
						user(login: $login) {
							contributionsCollection(from: $from, to: $to) {
								contributionCalendar {
									totalContributions
									weeks { contributionDays { contributionCount date color } }
								}
							}
						}
					}
				`,
				variables: { login: username, from: from.toISOString(), to: to.toISOString() },
			}),
		});
		const result = await response.json();
		calendar = result.data?.user?.contributionsCollection?.contributionCalendar;
	} catch {
		calendar = undefined;
	}
}
---

{
	calendar && (
		<section class="contributions" aria-labelledby="contributions-title">
			<div class="contributions-heading">
				<h2 id="contributions-title">GitHub Contributions</h2>
				<a href={`https://github.com/${username}`} target="_blank" rel="noreferrer">
					{calendar.totalContributions} contributions in the last year
				</a>
			</div>
			<div class="calendar" aria-label={`GitHub contribution calendar for ${username}`}>
				{calendar.weeks.flatMap((week) =>
					week.contributionDays.map((day) => (
						<span
							class="day"
							style={`background-color: ${day.contributionCount > 0 ? day.color : 'rgba(96, 115, 159, 0.15)'}`}
							title={`${day.date}: ${day.contributionCount} contributions`}
						></span>
					)),
				)}
			</div>
		</section>
	)
}

<script>
	const calendar = document.querySelector<HTMLElement>('.calendar');
	if (calendar) {
		requestAnimationFrame(() => {
			calendar.scrollLeft = calendar.scrollWidth;
		});
	}
</script>

<style>
	.contributions {
		margin-top: 3rem;
	}
	.contributions-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.contributions-heading h2 {
		margin: 0;
		font-size: 1.2rem;
	}
	.contributions-heading a {
		font-size: 0.75rem;
		text-decoration: none;
	}
	.calendar {
		display: grid;
		grid-template-rows: repeat(7, 12px);
		grid-auto-flow: column;
		grid-auto-columns: 12px;
		gap: 4px;
		overflow-x: auto;
		padding-bottom: 0.4rem;
	}
	.day {
		width: 12px;
		height: 12px;
		border-radius: 3px;
	}
	@media (max-width: 720px) {
		.contributions-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.2rem;
		}
	}
</style>
